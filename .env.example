# InvestIQ System Configuration
SECRET_KEY=investiq-secret-key-production-change-2026
JWT_SECRET_KEY=investiq-secret-key-production-change-2026
JWT_EXPIRATION_HOURS=24

# Frontend Dashboard Base URL (Used for deep-links in notification emails)
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Configuration for Automated Email Notifications
# To use Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account (https://myaccount.google.com/security)
# 2. Generate a 16-character App Password (https://myaccount.google.com/apppasswords)
# 3. Enter your Gmail address and 16-character App Password below (omit spaces)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_FROM_EMAIL=your-email@gmail.com
